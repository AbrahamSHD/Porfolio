---
import { GitHub, Link, LinkButton } from "../components";
import { ICONS as TAGS } from "../utils/icons";

const PROJECTS = [
  {
    title: "CyberMerch",
    highlights: [
      "Backend para una plataforma de comercio electrónico con NestJS, Prisma ORM y PostgreSQL.",
      "Control de acceso basado en roles: solo los administradores pueden crear, editar o eliminar productos.",
      "Documentación de la API con Swagger.",
    ],
    github: "https://github.com/AbrahamSHD/CyberMerch",
    tags: [TAGS.TYPESCRIPT, TAGS.NESTJS, TAGS.NODE, TAGS.POSTGRESQL, TAGS.PRISMA],
  },
  {
    title: "JournalApp - App de notas con React",
    highlights: [
      "Aplicación de notas con React y Redux para crear, editar y eliminar notas.",
      "Autenticación de usuarios y almacenamiento de las notas en Firebase.",
      "Carga de imágenes adjuntas a las notas con Cloudinary.",
    ],
    link: "https://journal-app-ahc.netlify.app/",
    github: "https://github.com/AbrahamSHD/JournalApp",
    image: "/projects/JournalApp.jpeg",
    tags: [TAGS.JAVASCRIPT, TAGS.REACT, TAGS.REDUX],
  },
  {
    title: "API Store",
    highlights: [
      "API REST con Express, MongoDB y TypeScript para gestionar productos y categorías.",
      "Autenticación con JWT y encriptación de datos.",
      "Almacenamiento de imágenes y envío de correos electrónicos.",
    ],
    github: "https://github.com/AbrahamSHD/User-Store",
    image: "/projects/APIStore.png",
    tags: [TAGS.EXPRESS, TAGS.NODE, TAGS.MONGODB, TAGS.TYPESCRIPT],
  },
  {
    title: "TicketFlow",
    highlights: [
      "Sistema de gestión de colas en tiempo real, sin límite de tickets ni de escritorios.",
      "Una pantalla muestra, mediante WebSockets, el escritorio al que se asigna cada ticket.",
      "Desarrollado con Express y TypeScript.",
    ],
    github: "https://github.com/AbrahamSHD/ticket-app",
    image: "/projects/TicketFlow.jpg",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.TYPESCRIPT, TAGS.NODE, TAGS.EXPRESS],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, highlights, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            {image ? (
              <img
                alt={`Captura del proyecto ${title}`}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            ) : (
              <div class="flex flex-col items-center justify-center gap-4 w-full h-56 md:h-64 bg-gradient-to-br from-[#232323] via-[#3b0a2a] to-[#e0234e]">
                <span class="text-3xl font-bold text-white">{title}</span>
                <div class="flex gap-3">
                  {tags.map((tag) => <tag.icon class="size-8" />)}
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row flex-wrap mb-2 gap-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <ul class="mt-2 flex flex-col gap-1 list-disc pl-5 text-gray-400">
              {highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

